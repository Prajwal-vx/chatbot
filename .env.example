APP_ENV=development
APP_NAME=whatsapp-ai-assistant
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant
REDIS_URL=redis://localhost:6379/0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-this-to-a-long-random-value
WHATSAPP_API_VERSION=v26.0
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_INPUT_CHARS=12000
MAX_OUTPUT_TOKENS=400
MAX_CONTEXT_CHARS=16000
REQUESTS_PER_MINUTE=20
ADMIN_API_TOKEN=replace-with-a-long-random-token
ENABLE_DEV_SIMULATOR=false
CONVERSATION_HISTORY_LIMIT=12
MEMORY_LIMIT=10
APP_TIMEZONE=Asia/Kathmandu
MESSAGE_RETENTION_DAYS=30
